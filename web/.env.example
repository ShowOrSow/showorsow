# Base URL for the ShowOrSow Go backend (05-backend.md §2). All API calls go here.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Rewrite target for same-origin /api/* (next.config.ts, server-side only — it is
# NOT exposed to the browser). On Vercel this is the VPS API origin, which is what
# keeps the session cookie same-origin. Defaults to http://localhost:8080.
API_ORIGIN=

# Walkthrough embed on the landing page (YouTube/Loom share URL). Blank → the
# page shows a placeholder that links to the live demo instead of a dead frame.
NEXT_PUBLIC_DEMO_VIDEO_URL=
